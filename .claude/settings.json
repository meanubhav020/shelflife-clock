{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/hooks/pre_send_check.py\""
          }
        ]
      },
      {
        "matcher": "(?i).*(send|reply|forward).*",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/hooks/pre_send_check.py\""
          }
        ]
      }
    ]
  }
}
